{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": "6000"
      }
    },
    "gitnexus": {
      "type": "local",
      "command": [
        "C:\\Users\\admin\\AppData\\Roaming\\npm\\gitnexus.cmd",
        "mcp"
      ],
      "env": {
        "GITNEXUS_MCP_DEFAULT_REPO": "licuti-cms-laravel"
      }
    }
  }
}